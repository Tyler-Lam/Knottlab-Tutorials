   "source": [
    "ranks = pivot.rank(axis = 0)\n",
    "ranks"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Get the correlations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Numbas parallelized version of correlations.\n",
    "# Faster than pairwise scipy.stats.spearmanr\n",
    "# Slower than np.corrcoef (?) but handles nan values\n",
    "corr = fast_corr(ranks.to_numpy())\n",
    "corr_df = pd.DataFrame(corr, columns = ranks.columns, index = ranks.columns)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Calculate the distance matrix/linkage and find the best threshold for clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "metadata": {},
   "outputs": [],
   "source": [
    "dist = 1 - corr\n",
    "dist_condensed = squareform(dist)\n",
    "Z = linkage(dist_condensed, method = 'average') "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Calculate best distance for clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "thresholds = []\n",
    "scores = []\n",
    "best_labels = []\n",
    "best_threshold = 0\n",
    "best_score = -1\n",
    "\n",
    "for t in np.linspace(0, 1, 200):\n",
    "    labels = fcluster(Z, t = t, criterion = 'distance')\n",
    "    n_clusters = len(np.unique(labels))\n",
    "    if n_clusters > 1 and n_clusters < len(corr):\n",
    "        score = silhouette_score(dist, labels = labels, metric = 'precomputed')\n",
    "        thresholds.append(t)\n",
    "        scores.append(score)\n",
    "        if score > best_score:\n",
    "            best_labels = labels\n",
    "            best_threshold = t\n",
    "            best_score = score\n",
    "            \n",
    "plt.plot(thresholds, scores)\n",
    "plt.axvline(x = best_threshold, color = 'r', linestyle = '--', label = f'Best threshold = {best_threshold:.3f}')\n",
    "plt.xlabel(\"Threshold\")\n",
    "plt.ylabel(\"Silhouette score\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
