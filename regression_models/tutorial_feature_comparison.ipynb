  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Do the permutation testing for the likelihood ratio tests"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Running test permutations to job allocation\n",
      "   Running test with inner parallelism ... done: 35.33 s\n",
      "   Running test with outer parallelism ... done: 70.54 s\n",
      "Estimated time with inner parallelism: 117.78 min\n",
      "Estimated time with outer parallelism: 5.88 min\n",
      "{'n_jobs': 47, 'n_jobs_inner': 1}\n"
     ]
    }
   ],
   "source": [
    "# Optional step is to check whether to do inner or outer parallelism\n",
    "# Depending on number of jobs/models/nodes, sometimes it is faster to run each permutation in parallel\n",
    "# Other times it may be faster to run permutations in series but parallelize the model fitting\n",
    "# Due to joblib limitations we cannot do nested parallelism\n",
    "# These are very rough estimates.\n",
    "\n",
    "jobs_dict = glms.test_run(n_perm = 200)\n",
    "print(jobs_dict)\n",
    "\n",
    "# If you don't want to do the test run, in general this will be \n",
    "# the fastest if you have many features\n",
    "\n",
    "#jobs_dict = {'n_jobs': multiprocessing.cpu_count() -1, 'n_jobs_inner': 1}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Calculating permutations: 100%|██████████| 200/200 [01:33<00:00,  2.14it/s]\n"
     ]
    }
   ],
   "source": [
    "import multiprocessing\n",
    "n_jobs = int(multiprocessing.cpu_count())\n",
    "stat_res = glms.run_stats_with_permutations(\n",
    "    n_permutations = 200, # number of permutations (null distribution will have <= n_permutations * n_features test stats). We're only doing 200 for brevity. Generally I'll do 1000\n",
    "    **jobs_dict, # Job allocation for inner/outer parallelism from test_run()\n",
    "    random_state = 42, # For reproducibility. If you split your jobs you must set this so permutations can be combined between different jobs\n",
    "    do_pairwise = False, # We're only doing the LLR test in this iteration. No pairwise comparisons\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Since we didn't do pairwise comparisons, the only output is the LLR results"
